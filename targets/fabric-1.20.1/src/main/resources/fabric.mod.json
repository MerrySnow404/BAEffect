{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "client": ["com.sighs.baeffect.fabric.BaeffectFabricClient"]
  },
  "mixins": [
    "baeffect.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
